{
  "name": "@agilab/emulator",
  "version": "0.1.0",
  "private": false,
  "description": "Local AG-UI emulator — test your agent UI without a real agent",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "agui-emulator": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ag-ui/core": "latest"
  },
  "devDependencies": {
    "typescript": "^5",
    "tsup": "^8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinkesh2010rpp/agui-react-client.git"
  },
  "keywords": [
    "ag-ui",
    "emulator",
    "agent",
    "testing",
    "mock"
  ],
  "license": "MIT"
}
