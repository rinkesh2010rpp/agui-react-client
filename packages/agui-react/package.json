{
  "name": "@agentui/react",
  "version": "0.1.0",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@ag-ui/client": "latest",
    "@ag-ui/core": "latest"
  },
  "devDependencies": {
    "@types/react": "^18",
    "tsup": "^8",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rinkesh2010rpp/agui-react-client.git",
    "directory": "packages/agui-react"
  },
  "homepage": "https://github.com/rinkesh2010rpp/agui-react-client/tree/master/packages/agui-react#readme",
  "bugs": {
    "url": "https://github.com/rinkesh2010rpp/agui-react-client/issues"
  }
}
